{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "$comment": "From engineering-standards harness v1.0.0. .env.* is not denied by glob because permission rules cannot exempt .env.example; guard-files.py enforces the full rule. The Stop hook runs npm run check:fast once per stop (stop_hook_active loop guard).",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run check:fast)",
      "Bash(npm run check)",
      "Bash(npm run knip)",
      "Bash(npm run docs:check)",
      "Bash(npm run skills:check)",
      "Bash(npm run security:check)",
      "Bash(npm run build)",
      "Bash(npm run test:db)",
      "Bash(npm run test:browser)",
      "Bash(npm run test:integration)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch --show-current:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)"
    ],
    "ask": ["Bash(git push:*)", "Bash(gh pr merge:*)", "Bash(gh release:*)"],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(pkill -f:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf:*)",
      "Bash(git push --force-with-lease:*)",
      "Read(./.env)",
      "Read(**/.env)",
      "Read(./.env.local)",
      "Read(**/.env.local)",
      "Read(./.env.development)",
      "Read(**/.env.development)",
      "Read(./.env.production)",
      "Read(**/.env.production)",
      "Read(./.env.test)",
      "Read(**/.env.test)",
      "Read(./.env.staging)",
      "Read(**/.env.staging)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.py\""
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-files.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -c 'import json,os,subprocess,sys\nd=json.load(sys.stdin)\nif d.get(\"stop_hook_active\"):sys.exit(0)\nr=subprocess.run([\"npm\",\"run\",\"check:fast\"],capture_output=True,text=True,timeout=170,cwd=os.environ.get(\"CLAUDE_PROJECT_DIR\",\".\"))\nif r.returncode:\n sys.stderr.write(\"check:fast failed; fix before finishing.\\n\"+(r.stdout+r.stderr)[-1500:]);sys.exit(2)'",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
