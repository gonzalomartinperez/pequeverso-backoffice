# Runtime configuration of the backoffice (server-side only; nothing here is sent to the browser).
# Copy to .env.local for local work. Never commit real values. Production refuses weak settings.

# development | test | production. Unset means production when NODE_ENV=production (the image sets
# production). development is refused on a production build; test only on a loopback origin.
BACKOFFICE_ENVIRONMENT=development
# Exact public origin of the backoffice (https in production). Proposed host is pending approval.
BACKOFFICE_ORIGIN=http://localhost:3201
# >= 32 random characters (e.g. `openssl rand -base64 32`). Secret. Required everywhere except test.
BETTER_AUTH_SECRET=
# Private PostgreSQL database of the backoffice. Secret.
DATABASE_URL=postgres://backoffice:change-me@127.0.0.1:5432/backoffice
# The only identity admitted without an invitation (provider-verified e-mail).
OWNER_EMAIL=
# OAuth apps created by the owner (callback: <BACKOFFICE_ORIGIN>/api/auth/callback/<provider>).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Private ops endpoint of pequeverso-assistant-api (internal network, not the public route) and
# its read token (>= 32 characters, same value as the API's OPS_READ_TOKEN). Secret.
# https, or http only to a single-label Docker service name (private network) or a host listed
# in OPS_API_INSECURE_INTERNAL_HOSTS.
OPS_API_URL=
OPS_READ_TOKEN=
# OPS_API_INSECURE_INTERNAL_HOSTS=
# Reverse-proxy addresses/CIDRs allowed to set X-Forwarded-For (client IP for sign-in rate limits).
# Empty: forwarded chains are not trusted and a warning is logged at startup.
TRUSTED_PROXY_IPS=

# Test only (refused in production): local fake IdP and disabling the per-IP sign-in limiter.
# AUTH_TEST_ISSUER=http://127.0.0.1:8238
# AUTH_DISABLE_RATE_LIMIT=1

# Standard Next.js server settings (the image sets these).
# PORT=3000
# HOSTNAME=0.0.0.0

# Optional private operational telemetry. OFF unless explicitly enabled by the operator.
OPS_TELEMETRY_ENABLED=false
OBSERVABILITY_METRICS_ENABLED=false
# Separate from OPS_READ_TOKEN; private machine scrape only, never a public URL or client env.
OBSERVABILITY_READ_TOKEN=
OBSERVABILITY_TRACES_ENABLED=false
# Private OTLP collector HTTP JSON /v1/traces. No ambient OTEL_* settings when enabled.
OBSERVABILITY_OTLP_TRACES_ENDPOINT=

# Local fixture aggregate reads only; refused in production. Never enables collection.
PRODUCT_ANALYTICS_READ_ENABLED=false
