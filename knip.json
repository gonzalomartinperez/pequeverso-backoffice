{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/*.ts",
    "tests/unit/**/*.test.ts",
    "tests/integration/**/*.test.ts",
    "tests/unit/support/container-probe.ts",
    "tests/unit/support/server-modules.ts",
    "tests/browser/**/*.spec.ts",
    "tests/browser/auth.setup.ts",
    "tests/visual/**/*.spec.ts",
    "playwright.visual.config.ts"
  ],
  "ignore": ["tests/authz/fixtures/**"],
  "project": ["src/**/*.{ts,tsx,css}", "scripts/**/*.ts", "tests/**/*.ts", "*.config.ts"],
  "ignoreDependencies": ["c8"]
}
