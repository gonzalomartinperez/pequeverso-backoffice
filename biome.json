{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!package-lock.json",
      "!next-env.d.ts",
      "!public",
      "!contracts/ops/ops.schema.json",
      "!contracts/ops/ops.summary.example.json",
      "!contracts/telemetry/ops.telemetry.schema.json",
      "!contracts/telemetry/ops.telemetry.example.json",
      "!contracts/analytics/product-analytics.schema.json",
      "!contracts/analytics/site-experience-pequeverso-v1.schema.json",
      "!contracts/analytics/product-analytics.example.json",
      "!contracts/analytics/profile.source.json",
      "!contracts/analytics/analytics-semantics.examples.json",
      "!**/*.md"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "css": {
    "parser": {
      "tailwindDirectives": true,
      "cssModules": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "error",
        "useImportType": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "next/router": "App Router only: use next/navigation.",
              "child_process": "The app never spawns processes; scripts/ may.",
              "node:child_process": "The app never spawns processes; scripts/ may."
            }
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noImportCycles": "error"
      },
      "correctness": {
        "noPrivateImports": "error",
        "noUndeclaredDependencies": "error"
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended",
      "test": "recommended",
      "project": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["scripts/**", "tests/**", "*.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ]
}
