{
  "name": "pequeverso-backoffice",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --port 3201",
    "build": "next build --webpack",
    "start": "next start --port 3201",
    "typecheck": "next typegen && node node_modules/typescript/bin/tsc --noEmit",
    "lint": "biome ci --error-on-warnings .",
    "format": "biome check --write .",
    "test": "node --test \"tests/unit/**/*.test.ts\"",
    "test:property:nightly": "FC_NUM_RUNS=1000 FC_FUZZ_RUNS=5000 node --test tests/unit/properties.test.ts tests/unit/validator-fuzz.test.ts",
    "test:browser": "playwright test",
    "security:check": "node scripts/check-public-files.ts",
    "docs:check": "node scripts/check-docs.ts",
    "skills:check": "node scripts/check-skills.ts",
    "copy:check": "node scripts/copy-lint.ts",
    "knip": "knip --no-progress",
    "setup": "node scripts/setup.ts",
    "check:fast": "npm run lint && npm run typecheck && npm test",
    "check": "npm run lint && npm run typecheck && npm test && npm run knip && npm run security:check && npm run docs:check && npm run skills:check && npm run copy:check && npm run build",
    "test:integration": "node --test \"tests/integration/**/*.test.ts\"",
    "preview:backoffice": "node scripts/backoffice-stack.ts",
    "db:migrate": "node scripts/db-migrate.ts",
    "db:check": "node scripts/db-check.ts",
    "coverage": "node scripts/coverage.ts",
    "coverage:check": "node scripts/check-coverage.ts && node scripts/diff-coverage.ts",
    "test:db": "node scripts/db-check.ts && npm run test:integration"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "better-auth": "1.7.15",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.66.0",
    "next": "16.4.4",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.7",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/typescript6": "6.0.2",
    "c8": "12.0.0",
    "fast-check": "4.10.2",
    "knip": "6.45.1",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2"
  }
}
